# pf web plugin (minimal)
task web-dev
  shell_lang bash
  shell node tools/static-server.mjs ${dir:-web} ${port:-8080}
end

task web-test
  shell_lang bash
  shell npx playwright test --reporter=list
end

task web-test-headed
  shell_lang bash
  shell npx playwright test --headed --reporter=list
end

task web-test-headed-slow
  shell_lang bash
  # slowmo in ms; override with `pf web-test-headed-slow slowmo=300`
  shell npx playwright test --headed --slow-mo ${slowmo:-250} --reporter=list
end

task web-test-ui
  shell_lang bash
  shell npx playwright test --ui
end

task web-test-chromium-headed-slow
  shell_lang bash
  shell npx playwright test --project=chromium --headed --slow-mo ${slowmo:-250} --reporter=list
end

task web-test-firefox-headed-slow
  shell_lang bash
  shell npx playwright test --project=firefox --headed --slow-mo ${slowmo:-250} --reporter=list
end

task web-test-webkit-headed-slow
  shell_lang bash
  shell npx playwright test --project=webkit --headed --slow-mo ${slowmo:-250} --reporter=list
end

task web-show-report
  shell_lang bash
  shell npx playwright show-report
end

task web-build-rust
  shell_lang bash
  shell cd demos/pf-web-polyglot-demo-plus-c/rust && wasm-pack build --target web --out-dir ../web/wasm/rust/pkg --out-name rust_demo
end

task web-build-c
  shell_lang bash
  shell cd demos/pf-web-polyglot-demo-plus-c/c && emcc c_trap.c -O0 -sASSERTIONS=1 -sMODULARIZE -sEXPORT_ES6 -sENVIRONMENT=web -sEXPORTED_FUNCTIONS=_trigger_trap,_main -sINVOKE_RUN=0 -o ../web/wasm/c/c_trap.js
end

task web-build-fortran
  shell_lang bash
  shell cd demos/pf-web-polyglot-demo-plus-c/fortran && lfortran src/hello.f90 -o ../web/wasm/fortran/fortran.wasm --target=wasm32-unknown-unknown
end

task web-build-wat
  shell_lang bash
  shell cd demos/pf-web-polyglot-demo-plus-c/asm && wat2wasm mini.wat -o ../web/wasm/asm/mini.wasm
end

task web-build-all
  shell_lang bash
  shell pf web-build-rust
  shell pf web-build-c
  shell pf web-build-fortran
  shell pf web-build-wat
end

# CLI runner tasks
task cli-run-wat
  shell_lang bash
  shell node tools/polyglot-cli/runner.mjs --lang=wat --action=run
end

task cli-dry
  shell_lang bash
  shell node tools/polyglot-cli/runner.mjs --lang=${lang:-wat} --action=${action:-run} --dry-run
end

task cli-test
  shell_lang bash
  shell node --test tests/cli
end
